# ==============================================================================
# TryPatchBay Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit production secrets or private tokens to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# State Directory (Defaults to .patchversion-state in workspace, or /tmp in serverless)
# PATCHVERSION_STATE_DIR=/var/tmp/.patchversion-state

# GitHub App Integration
# Required for live pull-request delivery and signed webhook ingestion on GitHub.
# Leave blank to use the built-in deterministic offline sandbox provider.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sandbox Execution Policy
# "local" admits trusted fixtures (sample-repo, lodash-repo) in isolated copy
# "docker" mode is blocked as unverified pending container isolation qualification
SANDBOX_MODE=local
SANDBOX_TIMEOUT_MS=120000

# Fix Generation Fallback
# Optional Anthropic API key for non-deterministic patch generation fallback
# ANTHROPIC_API_KEY=

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
