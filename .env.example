# ==============================================================================
# TryPatchBay Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit production secrets or private tokens to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Stateless HMAC Session Signing Secret
# Required in production. Minimum 32-character random hex/alphanumeric string for HMAC-SHA256 session tokens.
# When omitted in local development/test, a fallback development secret is used.
PATCHVERSION_SESSION_SECRET=

# State Directory (Defaults to .patchversion-state in workspace, or /tmp in serverless)
# PATCHVERSION_STATE_DIR=/var/tmp/.patchversion-state

# GitHub App Integration
# Required for live pull-request delivery and signed webhook ingestion on GitHub.
# Leave blank to use the built-in deterministic offline sandbox provider.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sandbox Execution Policy
# "local" admits trusted fixtures (sample-repo, lodash-repo) in isolated copy
# "docker" mode is blocked as unverified pending container isolation qualification
SANDBOX_MODE=local
SANDBOX_TIMEOUT_MS=120000

# Fix Generation Fallback
# Optional Anthropic API key for non-deterministic patch generation fallback
# ANTHROPIC_API_KEY=

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Hosted PostgreSQL is optional. Supported npm scripts clear DATABASE_URL and
# POSTGRES_URL before child processes unless the command is an explicit database
# command. A raw node or psql process still inherits the shell environment.
# db:status creates schema_migrations and requires PATCHVERSION_ACK_STATUS_DDL=1.
# Direct worker startup also requires PATCHVERSION_ALLOW_WORKER_DATABASE=1.
# DATABASE_URL=
# POSTGRES_URL=
