{
  "name": "@patchversion/engine",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/hosted-db-guard.js strip -- sh -c \"tsc && node -e \\\"require('fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true, force: true }); require('fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\\\"\"",
    "test": "node ../../scripts/hosted-db-guard.js strip -- jest --runInBand --passWithNoTests",
    "test:postgres": "node ../../scripts/hosted-db-guard.js local-test -- jest --runInBand --passWithNoTests test/postgres-live.integration.test.ts test/lifecycle-replay-store.test.ts",
    "typecheck": "node ../../scripts/hosted-db-guard.js strip -- tsc --noEmit",
    "start": "node ../../scripts/hosted-db-guard.js strip -- node dist/index.js",
    "prove": "node ../../scripts/hosted-db-guard.js strip -- node dist/prove.js",
    "prove:real": "node ../../scripts/hosted-db-guard.js strip -- node dist/prove.js fixtures/lodash-repo fixtures/real-migration/lodash-change-record.json runs/lodash-4-migration acme/membership",
    "readiness": "node ../../scripts/hosted-db-guard.js strip -- node dist/readiness/cli.js",
    "db:migrate": "node dist/db/cli-migrate.js up",
    "db:status": "node dist/db/cli-migrate.js status",
    "db:verify": "node dist/db/cli-migrate.js verify"
  },
  "dependencies": {
    "@patchversion/shared": "*",
    "@types/pg": "8.23.1",
    "diff": "^9.0.0",
    "pg": "8.23.1",
    "semver": "^7.6.0",
    "ts-morph": "^22.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
